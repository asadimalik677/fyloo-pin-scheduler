# Pinterest app credentials (from developers.pinterest.com)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Optional: if set, this token is used instead of the OAuth-stored token
# PINTEREST_ACCESS_TOKEN=
# Optional: protect /api/publish-due when called by an external cron
# CRON_SECRET=
# Vercel KV (Upstash Redis) for durable queue + token storage.
# If absent, a local JSON file under data/ is used (dev only, NOT durable on Vercel).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
